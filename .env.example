# Copy this file to .env and fill in real values before running
# docker-compose up. Both are optional: the worker warns and nacks the
# affected job types if either is unset (see worker/cmd/main.go), so
# tool_call/echo, tool_call/tavily_search without a key set, and any
# agent that only uses those will still work without this file at all.
TAVILY_API_KEY=
GROQ_API_KEY=
